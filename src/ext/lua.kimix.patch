diff --git a/larena.c b/larena.c
new file mode 100644
index 00000000..cd87879c
--- /dev/null
+++ b/larena.c
@@ -0,0 +1,1096 @@
+/*
+** $Id: larena.c $
+** kimix extension: per-lua_State memory arena (KIMIX_LUA_ARENA)
+** See Copyright Notice in lua.h
+*/
+
+#define larena_c
+#define LUA_CORE
+#define LUA_LIB
+
+#include "lprefix.h"
+
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "lua.h"
+
+#include "lauxlib.h"
+#include "larena.h"
+#include "lstate.h"
+
+#include <mimalloc.h>		/* the one heap of the process */
+
+
+#if defined(KIMIX_LUA_ARENA)		/* { */
+
+/*
+** {==================================================================
+** Small helpers
+** ===================================================================
+*/
+
+static unsigned arena_align16 (size_t n) {
+  return cast_uint((n + 15u) & ~cast_sizet(15u));
+}
+
+
+static int arena_log2 (size_t v) {
+  int l = 0;
+  while (v > 1) {
+    v >>= 1;
+    l++;
+  }
+  return l;
+}
+
+
+static int arena_ispow2 (size_t v) {
+  return v != 0 && (v & (v - 1)) == 0;
+}
+
+
+static int arena_hasenv (const char *name) {
+  const char *v = getenv(name);
+  return v != NULL && v[0] != '\0' && !(v[0] == '0' && v[1] == '\0');
+}
+
+
+void lua_arena_defaults (lua_ArenaConfig *cfg) {
+  cfg->segment_bytes = ARENA_DEF_SEGMENT;
+  cfg->small_max = ARENA_DEF_SMALL_MAX;
+  cfg->huge_cache = ARENA_DEF_HUGE_CACHE;
+  cfg->dry_run = 0;
+  cfg->gc_pause_pct = 0;
+  cfg->gc_stepmul = 0;
+  cfg->enable_compaction = 0;
+}
+
+/* }================================================================== */
+
+
+/*
+** {==================================================================
+** Class table (built once per arena)
+** ===================================================================
+*/
+
+static int arena_addclass (lua_Arena *a, unsigned slot, int tier) {
+  int i;
+  ArenaClass *c;
+  if (slot == 0 || slot > (unsigned)a->cfg.small_max)
+    return ARENA_CLASS_NONE;
+  for (i = 0; i < a->nclasses; i++) {
+    if (a->classes[i].slot_size == slot)
+      return i;  /* a slot size is one class, whatever its tier label */
+  }
+  if (a->nclasses >= ARENA_MAX_CLASSES)
+    return ARENA_CLASS_NONE;
+  c = &a->classes[a->nclasses];
+  memset(c, 0, sizeof(*c));
+  c->slot_size = slot;
+  c->nslots_per_seg = (unsigned)(a->cfg.segment_bytes / slot);
+  if (c->nslots_per_seg == 0)
+    c->nslots_per_seg = 1;  /* a big slot: one slot per segment */
+  c->seg_payload = c->nslots_per_seg * slot;
+  c->tier = tier;
+  return a->nclasses++;
+}
+
+
+static void arena_addgeneric (lua_Arena *a, unsigned slot, int tier) {
+  int cid = arena_addclass(a, slot, tier);
+  if (cid < 0)
+    return;
+  if (a->ngeneric > 0 && a->generic_slot[a->ngeneric - 1] >= slot)
+    return;  /* built in ascending order, so duplicates cannot happen */
+  if (a->ngeneric >= ARENA_MAX_CLASSES)
+    return;
+  a->generic_slot[a->ngeneric] = slot;
+  a->generic_class[a->ngeneric] = cid;
+  a->ngeneric++;
+}
+
+
+static void arena_build (lua_Arena *a) {
+  int log;
+  unsigned s;
+  a->nclasses = 0;
+  a->ngeneric = 0;
+  for (log = 0; log < 32; log++) {
+    a->arr_by_log[log] = ARENA_CLASS_NONE;
+    a->node_by_log[log] = ARENA_CLASS_NONE;
+    a->nodex_by_log[log] = ARENA_CLASS_NONE;
+  }
+  /* tiny tier: 16, 32, ..., 512 -> class ids 0..31, in this order, so
+     that 'lua_arena_classof' can index them directly */
+  for (s = ARENA_TINY_MIN; s <= ARENA_TINY_LIMIT; s += 16)
+    (void)arena_addclass(a, s, ARENA_TIER_TINY);
+  /* small + medium: x1.25 ladder snapped to 16 bytes, ending exactly at
+     'small_max' so that every inexact request below it finds a slot */
+  s = ARENA_TINY_LIMIT;
+  while (s < (unsigned)a->cfg.small_max) {
+    unsigned next = arena_align16(cast_sizet(s) + (s >> 2));
+    if (next <= s)
+      next = s + 16;
+    if (next > (unsigned)a->cfg.small_max)
+      next = (unsigned)a->cfg.small_max;
+    arena_addgeneric(a, next,
+                     (next <= ARENA_SMALL_TIER) ? ARENA_TIER_SMALL
+                                                : ARENA_TIER_MEDIUM);
+    s = next;
+  }
+  /* exact-size classes: table array blocks (9*N+4, N = 2^k) */
+  for (log = 0; log < 32; log++) {
+    size_t bytes = (cast_sizet(9) << log) + 4;
+    if (bytes > (size_t)a->cfg.small_max)
+      break;
+    a->arr_by_log[log] = arena_addclass(a, cast_uint(bytes), ARENA_TIER_ARR);
+  }
+  /* exact-size classes: table node blocks (32*2^k, plus the '+16' variant
+     when the node array carries a 'lastfree' prefix) */
+  for (log = 0; log < 32; log++) {
+    size_t bytes = cast_sizet(32) << log;
+    if (bytes > (size_t)a->cfg.small_max)
+      break;
+    a->node_by_log[log] = arena_addclass(a, cast_uint(bytes), ARENA_TIER_NODE);
+    if (bytes + 16 <= (size_t)a->cfg.small_max)
+      a->nodex_by_log[log] = arena_addclass(a, cast_uint(bytes + 16),
+                                           ARENA_TIER_NODE);
+  }
+}
+
+
+unsigned lua_arena_slotsize (lua_Arena *a, int cid) {
+  if (cid < 0 || cid >= a->nclasses)
+    return 0;
+  return a->classes[cid].slot_size;
+}
+
+
+/*
+** Pure function of the requested size. The same function maps 'osize'
+** back on free, so a block always returns to the class it came from and
+** no per-block metadata is needed.
+*/
+static int arena_exact_class (lua_Arena *a, size_t n) {
+  if (n > 4 && (n - 4) % 9 == 0) {	/* exact array block? */
+    size_t k = (n - 4) / 9;
+    if (arena_ispow2(k)) {
+      int log = arena_log2(k);
+      if (log < 32 && a->arr_by_log[log] != ARENA_CLASS_NONE)
+        return a->arr_by_log[log];
+    }
+  }
+  if (n % 32 == 0) {			/* exact node block? */
+    size_t k = n / 32;
+    if (arena_ispow2(k)) {
+      int log = arena_log2(k);
+      if (log < 32 && a->node_by_log[log] != ARENA_CLASS_NONE)
+        return a->node_by_log[log];
+    }
+  }
+  else if ((n - 16) % 32 == 0 && n > 16) {	/* ...with a prefix */
+    size_t k = (n - 16) / 32;
+    if (arena_ispow2(k)) {
+      int log = arena_log2(k);
+      if (log < 32 && a->nodex_by_log[log] != ARENA_CLASS_NONE)
+        return a->nodex_by_log[log];
+    }
+  }
+  return ARENA_CLASS_NONE;		/* not a table block size */
+}
+
+
+int lua_arena_classof (lua_Arena *a, size_t n) {
+  int cid;
+  if (n == 0)
+    return ARENA_CLASS_NONE;
+  if (n > (size_t)a->cfg.small_max)
+    return ARENA_CLASS_NONE;		/* huge tier */
+  /* An exact table-block class must win over the rounded one, or an
+     N-element array block would not be reused verbatim by the next one.
+     Below 512 the granule is 16 bytes, so the check is only needed for a
+     size that is not already a multiple of it. */
+  if (n > ARENA_TINY_LIMIT || (n & 15u) != 0) {
+    cid = arena_exact_class(a, n);
+    if (cid != ARENA_CLASS_NONE)
+      return cid;
+  }
+  if (n <= ARENA_TINY_LIMIT)		/* tiny: 16-byte granule */
+    return cast_int((n + 15u) >> 4) - 1;
+  {  /* generic ladder: the smallest slot size >= n */
+    int lo = 0, hi = a->ngeneric;
+    while (lo < hi) {
+      int mid = (lo + hi) >> 1;
+      if (a->generic_slot[mid] < n)
+        lo = mid + 1;
+      else
+        hi = mid;
+    }
+    if (lo < a->ngeneric)
+      return a->generic_class[lo];
+  }
+  return ARENA_CLASS_NONE;
+}
+
+/* }================================================================== */
+
+
+/*
+** {==================================================================
+** Segments and free lists
+** ===================================================================
+*/
+
+#if defined(KIMIX_LUA_MEMCHECK)
+#define arena_bit_test(s,i)	((s)->bits[(i) >> 3] & (1u << ((i) & 7)))
+#define arena_bit_set(s,i)	((s)->bits[(i) >> 3] |= cast(lu_byte, 1u << ((i) & 7)))
+#define arena_bit_clear(s,i)	((s)->bits[(i) >> 3] &= cast(lu_byte, ~(1u << ((i) & 7))))
+#endif
+
+
+static unsigned arena_slot_index (ArenaClass *c, ArenaSeg *s, void *p) {
+  return cast_uint((cast_charp(p) - cast_charp(s->base)) / c->slot_size);
+}
+
+
+static ArenaSeg *arena_new_segment (lua_Arena *a, int cid) {
+  ArenaClass *c = &a->classes[cid];
+  ArenaSeg *s;
+  void *base;
+  unsigned i;
+  if (c->seg_count >= c->seg_cap) {
+    unsigned ncap = (c->seg_cap == 0) ? 4u : c->seg_cap * 2u;
+    ArenaSeg **ns = cast(ArenaSeg **, mi_malloc(sizeof(ArenaSeg *) * ncap));
+    if (ns == NULL)
+      return NULL;
+    if (c->seg_count > 0)
+      memcpy(ns, c->segs, sizeof(ArenaSeg *) * c->seg_count);
+    if (c->segs != NULL)
+      mi_free(c->segs);
+    c->segs = ns;
+    c->seg_cap = ncap;
+  }
+  base = mi_malloc(c->seg_payload);
+  if (base == NULL)
+    return NULL;
+  s = cast(ArenaSeg *, mi_malloc(sizeof(ArenaSeg)));
+  if (s == NULL) {
+    mi_free(base);
+    return NULL;
+  }
+  memset(s, 0, sizeof(*s));
+  s->base = base;
+  s->nslots = c->nslots_per_seg;
+  s->nfree = s->nslots;
+  for (i = 0; i < s->nslots; i++) {	/* carve the segment into slots */
+    void *slot = cast_voidp(cast_charp(base) + cast_sizet(i) * c->slot_size);
+    *cast(void **, slot) = s->freelist;
+    s->freelist = slot;
+  }
+#if defined(KIMIX_LUA_MEMCHECK)
+  s->bits = cast(unsigned char *, mi_malloc((s->nslots >> 3) + 1));
+  if (s->bits == NULL) {
+    mi_free(base);
+    mi_free(s);
+    return NULL;
+  }
+  memset(s->bits, 0, (s->nslots >> 3) + 1);
+#endif
+  {  /* keep 'segs' sorted by base address (binary search on free) */
+    unsigned at = c->seg_count;
+    while (at > 0 && c->segs[at - 1]->base > base)
+      at--;
+    if (at < c->seg_count)
+      memmove(&c->segs[at + 1], &c->segs[at],
+              sizeof(ArenaSeg *) * (c->seg_count - at));
+    c->segs[at] = s;
+  }
+  c->seg_count++;
+  c->slots_total += s->nslots;
+  c->slots_free += s->nslots;
+  c->cur = s;
+  return s;
+}
+
+
+static void arena_drop_segment (ArenaClass *c, unsigned at) {
+  ArenaSeg *s = c->segs[at];
+  lua_arena_check(s->nfree == s->nslots);	/* only a wholly free segment */
+  c->seg_count--;
+  if (at < c->seg_count)
+    memmove(&c->segs[at], &c->segs[at + 1],
+            sizeof(ArenaSeg *) * (c->seg_count - at));
+  c->slots_total -= s->nslots;
+  c->slots_free -= s->nfree;
+  if (c->cur == s)
+    c->cur = NULL;
+#if defined(KIMIX_LUA_MEMCHECK)
+  mi_free(s->bits);
+#endif
+  mi_free(s->base);
+  mi_free(s);
+}
+
+
+static ArenaSeg *arena_find_seg (ArenaClass *c, const void *p) {
+  unsigned lo = 0, hi = c->seg_count;
+  const char *q = cast_charp(p);
+  while (lo < hi) {
+    unsigned mid = (lo + hi) >> 1;
+    const char *base = cast_charp(c->segs[mid]->base);
+    if (q < base)
+      hi = mid;
+    else if (q >= base + c->seg_payload)
+      lo = mid + 1;
+    else
+      return c->segs[mid];
+  }
+  return NULL;
+}
+
+
+void *lua_arena_take_slot (lua_Arena *a, int cid) {
+  ArenaClass *c = &a->classes[cid];
+  ArenaSeg *s = c->cur;
+  void *p;
+  if (s == NULL || s->nfree == 0 || (s->flags & ARENA_SEG_NOSLOT) != 0) {
+    unsigned i;
+    s = NULL;
+    for (i = 0; i < c->seg_count; i++) {
+      ArenaSeg *cand = c->segs[i];
+      if (cand->nfree > 0 && (cand->flags & ARENA_SEG_NOSLOT) == 0) {
+        s = cand;
+        break;
+      }
+    }
+    if (s == NULL) {
+      s = arena_new_segment(a, cid);	/* may return NULL */
+      if (s == NULL)
+        return NULL;
+      s->flags &= ~ARENA_SEG_NOSLOT;
+    }
+  }
+  c->cur = s;
+  p = s->freelist;
+  s->freelist = *cast(void **, p);
+  s->nfree--;
+  c->slots_free--;
+  c->slots_used++;
+  if (c->slots_used > c->high_water)
+    c->high_water = c->slots_used;
+#if defined(KIMIX_LUA_MEMCHECK)
+  arena_bit_set(s, arena_slot_index(c, s, p));
+#endif
+  return p;
+}
+
+
+void lua_arena_give_slot (lua_Arena *a, int cid, void *p) {
+  ArenaClass *c = &a->classes[cid];
+  ArenaSeg *s = arena_find_seg(c, p);
+  lua_arena_check(s != NULL);
+  if (s == NULL)			/* cannot happen */
+    return;
+#if defined(KIMIX_LUA_MEMCHECK)
+  {
+    unsigned idx = arena_slot_index(c, s, p);
+    lua_arena_check(arena_bit_test(s, idx));	/* double free? */
+    arena_bit_clear(s, idx);
+  }
+#endif
+  *cast(void **, p) = s->freelist;
+  s->freelist = p;
+  s->nfree++;
+  c->slots_free++;
+  c->slots_used--;
+  if (s->nfree == s->nslots)		/* prefer draining empty segments */
+    c->cur = s;
+  else if (c->cur == NULL)
+    c->cur = s;
+}
+
+
+ArenaSeg *lua_arena_segment (ArenaClass *c, const void *p) {
+  return arena_find_seg(c, p);
+}
+
+
+unsigned lua_arena_segment_index (ArenaClass *c, ArenaSeg *s) {
+  unsigned i;
+  for (i = 0; i < c->seg_count; i++) {
+    if (c->segs[i] == s)
+      return i;
+  }
+  return c->seg_count;
+}
+
+
+int lua_arena_release_segment (lua_Arena *a, int cid, ArenaSeg *s) {
+  ArenaClass *c = &a->classes[cid];
+  unsigned i = lua_arena_segment_index(c, s);
+  if (i >= c->seg_count || s->nfree != s->nslots)
+    return 0;			/* not whole, or not ours: leave it alone */
+  arena_drop_segment(c, i);
+  return 1;
+}
+
+/* }================================================================== */
+
+
+/*
+** {==================================================================
+** The huge tier: one exact run per request + a per-size LRU of freed runs
+** ===================================================================
+*/
+
+static void *arena_huge_acquire (lua_Arena *a, size_t n) {
+  unsigned i;
+  for (i = 0; i < a->nhuge; i++) {
+    if (a->huge[i].size == n) {
+      void *p = a->huge[i].p;
+      a->huge[i] = a->huge[--a->nhuge];	/* order does not matter */
+      a->huge_cached--;
+      a->huge_cached_bytes -= n;
+      a->huge_live_count++;
+      a->huge_live_bytes += n;
+      a->would_huge_reuse++;
+      return p;
+    }
+  }
+  {
+    void *p = mi_malloc(n);
+    if (p != NULL) {
+      a->huge_live_count++;
+      a->huge_live_bytes += n;
+    }
+    return p;
+  }
+}
+
+
+static void arena_huge_release (lua_Arena *a, void *p, size_t n) {
+  unsigned i, same = 0;
+  a->huge_live_count--;
+  a->huge_live_bytes -= n;
+  for (i = 0; i < a->nhuge; i++) {	/* keep 'huge_cache' runs per size */
+    if (a->huge[i].size == n)
+      same++;
+  }
+  if (same < (unsigned)a->cfg.huge_cache && a->nhuge < ARENA_MAX_HUGE) {
+    a->huge[a->nhuge].p = p;
+    a->huge[a->nhuge].size = n;
+    a->nhuge++;
+    a->huge_cached++;
+    a->huge_cached_bytes += n;
+  }
+  else
+    mi_free(p);
+}
+
+/* }================================================================== */
+
+
+/*
+** {==================================================================
+** Dry-run simulation (cfg.dry_run == 1): the same decisions, counters
+** only, memory straight from mimalloc
+** ===================================================================
+*/
+
+static void arena_dry_acquire (lua_Arena *a, int cid) {
+  ArenaClass *c = &a->classes[cid];
+  a->would_alloc++;
+  c->slots_used++;
+  if (c->slots_free > 0) {
+    c->slots_free--;
+    a->would_reuse++;
+  }
+  else {
+    c->slots_total += c->nslots_per_seg;
+    c->seg_count++;
+    c->slots_free = c->nslots_per_seg - 1;
+    a->would_segments++;
+  }
+  if (c->slots_used > c->high_water)
+    c->high_water = c->slots_used;
+}
+
+
+static void arena_dry_release (lua_Arena *a, int cid) {
+  ArenaClass *c = &a->classes[cid];
+  a->would_free++;
+  if (c->slots_used > 0)
+    c->slots_used--;
+  c->slots_free++;
+}
+
+
+static void arena_dry_huge_acquire (lua_Arena *a, size_t n) {
+  unsigned i;
+  a->would_alloc++;
+  a->huge_live_count++;
+  a->huge_live_bytes += n;
+  for (i = 0; i < a->nhuge_shadow; i++) {
+    if (a->huge_shadow[i] == n) {
+      a->huge_shadow[i] = a->huge_shadow[--a->nhuge_shadow];
+      a->would_huge_reuse++;
+      return;
+    }
+  }
+}
+
+
+static void arena_dry_huge_release (lua_Arena *a, size_t n) {
+  unsigned i, same = 0;
+  a->would_free++;
+  if (a->huge_live_count > 0)
+    a->huge_live_count--;
+  a->huge_live_bytes -= n;
+  for (i = 0; i < a->nhuge_shadow; i++) {
+    if (a->huge_shadow[i] == n)
+      same++;
+  }
+  if (same < (unsigned)a->cfg.huge_cache && a->nhuge_shadow < ARENA_MAX_HUGE)
+    a->huge_shadow[a->nhuge_shadow++] = n;
+}
+
+/* }================================================================== */
+
+
+/*
+** {==================================================================
+** Allocation trace (KIMIX_LUA_MEMTRACE=<path>, bounded, off by default)
+** ===================================================================
+*/
+
+static void arena_trace (lua_Arena *a, void *ptr, size_t osize,
+                         size_t nsize) {
+  int written;
+  if (a->trace_done)
+    return;
+  if (a->trace == NULL) {
+    const char *path = getenv("KIMIX_LUA_MEMTRACE");
+    const char *limit;
+    long mb = 64;
+    if (path == NULL || path[0] == '\0') {
+      a->trace_done = 1;		/* no tracing: out of the hot path */
+      return;
+    }
+    limit = getenv("KIMIX_LUA_MEMTRACE_MAX_MB");
+    if (limit != NULL) {
+      long v = strtol(limit, NULL, 10);
+      if (v > 0)
+        mb = v;
+    }
+          /* append: a process may create several arena states (a corpus run, the
+         unit suite), and one cumulative trace is what a replay wants. The
+         driver deletes the file when it wants a fresh one. */
+      a->trace = fopen(path, "ab");
+    a->trace_limit = cast_sizet(mb) * 1024u * 1024u;
+    if (a->trace == NULL) {
+      a->trace_done = 1;
+      return;
+    }
+  }
+  if (a->trace_written >= a->trace_limit) {
+    fclose(a->trace);
+    a->trace = NULL;
+    a->trace_done = 1;
+    return;
+  }
+  written = fprintf(a->trace,
+                    "{\"op\":\"%s\",\"cls\":%d,\"osize\":%lu,\"nsize\":%lu}\n",
+                    (nsize == 0) ? "f" : ((ptr == NULL) ? "a" : "r"),
+                    lua_arena_classof(a, (nsize == 0) ? osize : nsize),
+                    (unsigned long)osize, (unsigned long)nsize);
+  if (written > 0)
+    a->trace_written += cast_sizet(written);
+}
+
+/* }================================================================== */
+
+
+/*
+** {==================================================================
+** The allocator itself
+** ===================================================================
+*/
+
+static void *arena_acquire (lua_Arena *a, size_t n) {
+  int cid = lua_arena_classof(a, n);
+  if (cid == ARENA_CLASS_NONE) {		/* huge tier */
+    if (a->cfg.dry_run) {
+      arena_dry_huge_acquire(a, n);
+      return mi_malloc(n);
+    }
+    return arena_huge_acquire(a, n);
+  }
+  if (a->cfg.dry_run) {
+    arena_dry_acquire(a, cid);
+    return mi_malloc(n);
+  }
+  return lua_arena_take_slot(a, cid);
+}
+
+
+static void arena_release (lua_Arena *a, void *p, size_t osize) {
+  int cid = lua_arena_classof(a, osize);
+  if (cid == ARENA_CLASS_NONE) {
+    if (a->cfg.dry_run) {
+      arena_dry_huge_release(a, osize);
+      mi_free(p);
+      return;
+    }
+    arena_huge_release(a, p, osize);
+    return;
+  }
+  if (a->cfg.dry_run) {
+    arena_dry_release(a, cid);
+    mi_free(p);
+    return;
+  }
+  lua_arena_give_slot(a, cid, p);
+}
+
+
+static void arena_live_add (lua_Arena *a, size_t osize, size_t nsize) {
+  if (nsize >= osize)
+    a->logical_live += nsize - osize;
+  else
+    a->logical_live -= osize - nsize;
+}
+
+
+/*
+** The lua_Alloc the arena installs. Contract unchanged:
+** frealloc(ud, p, osize, 0) frees, frealloc(ud, NULL, x, s) creates,
+** frealloc(ud, b, x, y) reallocates; NULL means failure and a failed
+** reallocation leaves the old block untouched.
+*/
+void *lua_arena_alloc (void *ud, void *ptr, size_t osize, size_t nsize) {
+  lua_Arena *a = cast(lua_Arena *, ud);
+  a->calls++;
+  arena_trace(a, ptr, osize, nsize);
+  if (nsize == 0) {				/* free */
+    if (ptr != NULL) {
+      arena_release(a, ptr, osize);
+      a->logical_live -= osize;
+    }
+    return NULL;
+  }
+  if (ptr == NULL) {				/* fresh block */
+    void *p = arena_acquire(a, nsize);
+    if (p != NULL)
+      a->logical_live += nsize;
+    return p;
+  }
+  {						/* reallocate */
+    int oc = lua_arena_classof(a, osize);
+    int nc = lua_arena_classof(a, nsize);
+    void *p;
+    if (oc == nc && oc != ARENA_CLASS_NONE && a->cfg.dry_run == 0) {
+      /* the same slot serves both (a dry run cannot do this: mimalloc got
+         exactly 'osize' bytes, so the block has to be replaced) */
+      arena_live_add(a, osize, nsize);
+      return ptr;
+    }
+    if (oc == ARENA_CLASS_NONE && nc == ARENA_CLASS_NONE && osize == nsize &&
+        a->cfg.dry_run == 0)
+      return ptr;				/* same huge run, unchanged */
+    p = arena_acquire(a, nsize);
+    if (p == NULL)
+      return NULL;				/* old block still valid */
+    memcpy(p, ptr, (osize < nsize) ? osize : nsize);
+    arena_release(a, ptr, osize);
+    arena_live_add(a, osize, nsize);
+    return p;
+  }
+}
+
+/* }================================================================== */
+
+
+/*
+** {==================================================================
+** Trim / purge
+** ===================================================================
+*/
+
+static size_t arena_dry_trim (lua_Arena *a, ArenaClass *c) {
+  size_t freed = 0;
+  unsigned target, need;
+  if (c->seg_count == 0) {
+    c->high_water = 0;
+    return 0;
+  }
+  target = c->high_water / 2u;
+  if (target < c->slots_used)
+    target = c->slots_used;
+  need = (target + c->nslots_per_seg - 1u) / c->nslots_per_seg;
+  c->high_water = target;
+  while (c->seg_count > need && c->slots_free >= c->nslots_per_seg) {
+    c->seg_count--;
+    c->slots_total -= c->nslots_per_seg;
+    c->slots_free -= c->nslots_per_seg;
+    freed += c->seg_payload;
+  }
+  return freed;
+}
+
+
+size_t lua_arena_trim (lua_Arena *a, int level) {
+  size_t freed = 0;
+  int i;
+  if (a == NULL)
+    return 0;
+  a->trims++;
+  for (i = 0; i < a->nclasses; i++) {
+    ArenaClass *c = &a->classes[i];
+    unsigned target, need, j;
+    if (a->cfg.dry_run) {
+      freed += arena_dry_trim(a, c);
+      continue;
+    }
+    if (c->seg_count == 0) {
+      c->high_water = 0;
+      continue;
+    }
+    /* the high water decays by 1/2 on every trim, so repeated trims
+       converge instead of oscillating */
+    target = c->high_water / 2u;
+    if (target < c->slots_used)
+      target = c->slots_used;
+    need = (target + c->nslots_per_seg - 1u) / c->nslots_per_seg;
+    c->high_water = target;
+    j = c->seg_count;
+    while (j-- > 0 && c->seg_count > need) {
+      ArenaSeg *s = c->segs[j];
+      if (s->nfree == s->nslots) {	/* a whole empty segment */
+        freed += c->seg_payload;
+        arena_drop_segment(c, j);
+      }
+    }
+  }
+  if (level >= 1) {			/* also drop the huge cache */
+    for (i = 0; i < cast_int(a->nhuge); i++)
+      mi_free(a->huge[i].p);
+    a->huge_cached = 0;
+    a->huge_cached_bytes = 0;
+    a->nhuge = 0;
+    a->nhuge_shadow = 0;
+    mi_collect(true);			/* purge what is free right now */
+    a->purges++;
+  }
+  a->trim_bytes += freed;
+  return freed;
+}
+
+/* }================================================================== */
+
+
+/*
+** {==================================================================
+** Lifecycle and stats
+** ===================================================================
+*/
+
+lua_Arena *lua_arena_new (const lua_ArenaConfig *cfg) {
+  lua_Arena *a;
+  a = cast(lua_Arena *, mi_malloc(sizeof(lua_Arena)));
+  if (a == NULL)
+    return NULL;
+  memset(a, 0, sizeof(*a));
+  if (cfg != NULL)
+    a->cfg = *cfg;
+  else
+    lua_arena_defaults(&a->cfg);
+  /* sanity: the tiers assume a segment that can hold a tiny slot and a
+     'small_max' the generic ladder can reach */
+  if (a->cfg.segment_bytes < ARENA_TINY_MIN)
+    a->cfg.segment_bytes = ARENA_DEF_SEGMENT;
+  if (a->cfg.small_max < cast_int(ARENA_TINY_LIMIT))
+    a->cfg.small_max = ARENA_DEF_SMALL_MAX;
+  if (a->cfg.small_max > ARENA_DEF_SMALL_MAX * 16)
+    a->cfg.small_max = ARENA_DEF_SMALL_MAX * 16;
+  if (a->cfg.huge_cache < 0)
+    a->cfg.huge_cache = 0;
+  if (a->cfg.huge_cache > ARENA_MAX_HUGE)
+    a->cfg.huge_cache = ARENA_MAX_HUGE;
+  if (a->cfg.dry_run == 0 && arena_hasenv("KIMIX_LUA_ARENA_DRYRUN"))
+    a->cfg.dry_run = 1;
+  arena_build(a);
+  return a;
+}
+
+
+void lua_arena_free (lua_Arena *a) {
+  int i;
+  if (a == NULL)
+    return;
+  for (i = 0; i < a->nclasses; i++) {
+    ArenaClass *c = &a->classes[i];
+    if (a->cfg.dry_run == 0) {
+      while (c->seg_count > 0)
+        arena_drop_segment(c, c->seg_count - 1);
+    }
+    else  /* a dry run counted the segments, it never carved them */
+      c->seg_count = 0;
+    if (c->segs != NULL)
+      mi_free(c->segs);
+    c->segs = NULL;
+    c->seg_cap = 0;
+  }
+  for (i = 0; i < cast_int(a->nhuge); i++)
+    mi_free(a->huge[i].p);
+  if (a->trace != NULL)
+    fclose(a->trace);
+  mi_free(a);
+}
+
+
+void lua_arena_attach (lua_State *L, lua_Arena *a) {
+  G(L)->arena = a;
+}
+
+void lua_arena_interior_enter (lua_State *L) {
+  lua_Arena *a = (L != NULL) ? G(L)->arena : NULL;
+  if (a != NULL) {
+#if defined(KIMIX_LUA_MEMCHECK)
+    a->interior_holders++;
+#endif
+  }
+}
+
+void lua_arena_interior_leave (lua_State *L) {
+  lua_Arena *a = (L != NULL) ? G(L)->arena : NULL;
+  if (a != NULL) {
+#if defined(KIMIX_LUA_MEMCHECK)
+    lua_arena_check(a->interior_holders > 0);
+    if (a->interior_holders > 0)
+      a->interior_holders--;
+#endif
+  }
+}
+
+void lua_arena_interior_reset (lua_State *L) {
+  lua_Arena *a = (L != NULL) ? G(L)->arena : NULL;
+  if (a != NULL) {
+#if defined(KIMIX_LUA_MEMCHECK)
+    a->interior_holders = 0;
+#endif
+  }
+}
+
+/*
+** The plan a dry run can produce for 'lua_gc(LUA_GCCOMPACT)'. A source
+** segment is emptied only when every slot it holds is a live table array
+** block and its blocks fit into the free slots of the segments that stay,
+** i.e. 'm' sources need 'm * nslots_per_seg <= slots_free' and one segment
+** always remains as the target. On the counters alone that is exact when
+** every live block of the class is a table array block and an upper bound
+** otherwise -- which is what a dry run can know without carved segments.
+*/
+size_t lua_arena_dry_plan (lua_Arena *a) {
+  size_t would = 0;
+  int i;
+  if (a == NULL)
+    return 0;
+  for (i = 0; i < a->nclasses; i++) {
+    ArenaClass *c = &a->classes[i];
+    unsigned spares;
+    if (c->seg_count < 2 || c->nslots_per_seg == 0)
+      continue;				/* nothing to pack into */
+    spares = c->slots_free / c->nslots_per_seg;
+    if (spares >= c->seg_count)
+      spares = c->seg_count - 1;	/* one segment stays as the target */
+    would += cast_sizet(spares) * c->seg_payload;
+  }
+  return would;
+}
+
+
+void lua_arena_stats (lua_Arena *a, lua_ArenaStats *st) {
+  int i;
+  size_t slotted = 0, commit = 0;
+  memset(st, 0, sizeof(*st));
+  st->segment_bytes = a->cfg.segment_bytes;
+  st->dry_run = a->cfg.dry_run;
+  st->enabled = 1;
+  for (i = 0; i < a->nclasses; i++) {
+    ArenaClass *c = &a->classes[i];
+    st->slots_used += c->slots_used;
+    st->slots_free += c->slots_free;
+    st->seg_count += c->seg_count;
+    slotted += cast_sizet(c->slots_used) * c->slot_size;
+    commit += cast_sizet(c->seg_count) * c->seg_payload;
+  }
+  st->slots_total = st->slots_used + st->slots_free;
+  st->logical_live = a->logical_live;
+  st->huge_live_bytes = a->huge_live_bytes;
+  st->huge_live_count = a->huge_live_count;
+  st->huge_cached = a->huge_cached;
+  st->huge_cached_bytes = a->huge_cached_bytes;
+  if (a->cfg.dry_run) {		/* the shadow cache stands in for the real one */
+    unsigned k;
+    size_t sum = 0;
+    for (k = 0; k < a->nhuge_shadow; k++)
+      sum += a->huge_shadow[k];
+    st->huge_cached = a->nhuge_shadow;
+    st->huge_cached_bytes = sum;
+  }
+  st->commit_bytes = commit + a->huge_live_bytes + st->huge_cached_bytes;
+  st->internal_waste = (slotted + a->huge_live_bytes >= a->logical_live)
+                       ? slotted + a->huge_live_bytes - a->logical_live : 0;
+  st->calls = a->calls;
+  st->trims = a->trims;
+  st->trim_bytes = a->trim_bytes;
+  st->purges = a->purges;
+  st->would_segments = a->would_segments;
+  st->would_alloc = a->would_alloc;
+  st->would_free = a->would_free;
+  st->would_reuse = a->would_reuse;
+  st->would_huge_reuse = a->would_huge_reuse;
+  st->would_shrink_bytes = a->would_shrink_bytes;
+  st->would_compact_bytes = a->would_compact_bytes;
+  st->compacted_bytes = a->compacted_bytes;
+  st->compactions = a->compactions;
+  st->compaction_skips = a->compaction_skips;
+}
+
+/* }================================================================== */
+
+
+/*
+** {==================================================================
+** Public entry points (lua.h / lauxlib.h)
+** ===================================================================
+*/
+
+int lua_ArenaClassCount (void *arena) {
+  return (arena != NULL) ? cast(lua_Arena *, arena)->nclasses : 0;
+}
+
+
+int lua_ArenaClassOf (void *arena, size_t size) {
+  if (arena == NULL)
+    return ARENA_CLASS_NONE;
+  return lua_arena_classof(cast(lua_Arena *, arena), size);
+}
+
+
+int lua_ArenaClassInfoGet (void *arena, int cid, lua_ArenaClassInfo *info) {
+  lua_Arena *a = cast(lua_Arena *, arena);
+  ArenaClass *c;
+  if (a == NULL || info == NULL || cid < 0 || cid >= a->nclasses)
+    return 0;
+  c = &a->classes[cid];
+  info->slot_size = c->slot_size;
+  info->seg_payload = c->seg_payload;
+  info->seg_count = c->seg_count;
+  info->slots_used = c->slots_used;
+  info->slots_free = c->slots_free;
+  info->tier = c->tier;
+  return 1;
+}
+
+
+void lua_ArenaConfigDefault (lua_ArenaConfig *cfg) {
+  if (cfg != NULL)
+    lua_arena_defaults(cfg);
+}
+
+
+void lua_ArenaStatsOf (void *arena, lua_ArenaStats *st) {
+  if (st == NULL)
+    return;
+  if (arena == NULL) {
+    memset(st, 0, sizeof(*st));
+    return;
+  }
+  lua_arena_stats(cast(lua_Arena *, arena), st);
+}
+
+
+void lua_ArenaStatsGet (lua_State *L, lua_ArenaStats *st) {
+  lua_Arena *a = (L != NULL) ? G(L)->arena : NULL;
+  lua_ArenaStatsOf(a, st);
+}
+
+/* how many calls are holding an interior pointer right now (0 when the
+   KIMIX_LUA_MEMCHECK net is not part of this build) */
+unsigned lua_ArenaInteriorHolders (void *arena) {
+  lua_Arena *a = cast(lua_Arena *, arena);
+#if defined(KIMIX_LUA_MEMCHECK)
+  return (a != NULL) ? a->interior_holders : 0u;
+#else
+  (void)a;
+  return 0u;
+#endif
+}
+
+
+size_t lua_ArenaTrimHandle (void *arena, int level) {
+  if (arena == NULL)
+    return 0;
+  return lua_arena_trim(cast(lua_Arena *, arena), level);
+}
+
+
+size_t lua_ArenaTrim (lua_State *L, int level) {
+  return lua_ArenaTrimHandle((L != NULL) ? G(L)->arena : NULL, level);
+}
+
+
+void lua_ArenaFree (void *arena) {
+  lua_arena_free(cast(lua_Arena *, arena));
+}
+
+
+/*
+** Create a state served by a memory arena. Everything else is what
+** 'luaL_newstate' does; the GC pacing knobs of the configuration, when
+** set, are applied through the public API so that a memory-tight host
+** (a sandbox run) can trade speed for footprint without touching the
+** compiled-in defaults.
+*/
+lua_State *luaL_newstate_arena (const lua_ArenaConfig *cfg) {
+  lua_Arena *a = lua_arena_new(cfg);
+  lua_State *L;
+  if (a == NULL)
+    return NULL;
+  L = lua_newstate(lua_arena_alloc, a, luaL_makeseed(NULL));
+  if (L == NULL) {
+    lua_arena_free(a);
+    return NULL;
+  }
+  lua_arena_attach(L, a);
+  if (a->cfg.gc_pause_pct > 0)
+    (void)lua_gc(L, LUA_GCPARAM, LUA_GCPPAUSE, a->cfg.gc_pause_pct);
+  if (a->cfg.gc_stepmul > 0)
+    (void)lua_gc(L, LUA_GCPARAM, LUA_GCPSTEPMUL, a->cfg.gc_stepmul);
+  return L;
+}
+
+
+void *luaL_arena (lua_State *L) {
+  return (L != NULL) ? cast(void *, G(L)->arena) : NULL;
+}
+
+
+/* close the state and release the arena that served it */
+void luaL_freestate_arena (lua_State *L) {
+  lua_Arena *a = (L != NULL) ? G(L)->arena : NULL;
+  if (L != NULL) {
+    G(L)->arena = NULL;		/* nothing may look at it after this */
+    lua_close(L);
+  }
+  lua_arena_free(a);
+}
+
+/* }================================================================== */
+
+#endif					/* } */
diff --git a/larena.h b/larena.h
new file mode 100644
index 00000000..656696c4
--- /dev/null
+++ b/larena.h
@@ -0,0 +1,223 @@
+/*
+** $Id: larena.h $
+** kimix extension: per-lua_State memory arena (KIMIX_LUA_ARENA)
+** See Copyright Notice in lua.h
+*/
+
+/*
+** {==================================================================
+** Design (see .kimix_cache/lua_memory_opt_plan.md, sections 4.1-4.6)
+** ===================================================================
+** The arena is a 'lua_Alloc'. Everything below is a pure function of
+** the requested size: 'lua_arena_classof' maps a request to a size class
+** and the same function maps 'osize' back on free, so no per-block
+** header is needed (a header would cost 8-16 bytes on every 9*N+4 array
+** block). A slot is never smaller than the request, so even a
+** mis-classified block is a valid, correctly sized slot.
+**
+** Tiers (all sizes in bytes):
+**   tiny       <= 512       : 16-byte granule, 32 classes
+**   small      <= small_max : x1.25 steps snapped to 16
+**   medium     <= small_max : the same ladder (it is continuous;
+**                             tiny/small/medium only label it)
+**   exact-ARR  <= small_max : 9*N+4 with N a power of two, no rounding
+**   exact-NODE <= small_max : 32*2^k (+16 for the 'lastfree' prefix)
+**   huge       >  small_max : one exact run from mimalloc + a per-size
+**                             LRU of freed runs
+**
+** A class owns whole segments of 'segment_bytes' (64 KiB by default),
+** carved into 'nslots_per_seg' slots at first use. Each segment keeps its
+** own intrusive LIFO free list (the first pointer-sized bytes of a free
+** slot hold 'next'), so an empty segment is exactly a segment whose free
+** count equals its slot count -- which is what 'trim' hands back to
+** mimalloc. No locks: one arena per lua_State.
+*/
+
+#ifndef larena_h
+#define larena_h
+
+#include <stddef.h>
+#include <stdio.h>
+
+#include "lua.h"
+#include "llimits.h"
+
+#if defined(KIMIX_LUA_ARENA)		/* { */
+
+/*
+** Double-free / invalid-free checking: on whenever the build is not an
+** NDEBUG one, or explicitly through KIMIX_LUA_MEMCHECK.
+*/
+#if !defined(KIMIX_LUA_MEMCHECK) && !defined(NDEBUG)
+#define KIMIX_LUA_MEMCHECK	1
+#endif
+
+#if defined(KIMIX_LUA_MEMCHECK)
+#include <assert.h>
+#define lua_arena_check(c)	assert(c)
+#else
+#define lua_arena_check(c)	((void)0)
+#endif
+
+/* tiers, for diagnostics and for the compaction planner */
+#define ARENA_TIER_TINY		0
+#define ARENA_TIER_SMALL	1
+#define ARENA_TIER_MEDIUM	2
+#define ARENA_TIER_ARR		3
+#define ARENA_TIER_NODE		4
+
+/* 'lua_arena_classof' result for "not slotted" (the huge tier) */
+#define ARENA_CLASS_NONE	(-1)
+
+#define ARENA_MAX_CLASSES	192
+#define ARENA_MAX_HUGE		32	/* hard cap on cached huge runs */
+#define ARENA_TINY_MIN		16u
+#define ARENA_TINY_LIMIT	512u	/* tiny classes: 16, 32, ... 512 */
+#define ARENA_SMALL_TIER	8192u	/* 'small' tier label boundary */
+#define ARENA_DEF_SEGMENT	(64u * 1024u)
+#define ARENA_DEF_SMALL_MAX	65536	/* 'small_max' default */
+#define ARENA_DEF_HUGE_CACHE	4
+
+/* segment flags */
+#define ARENA_SEG_NOSLOT	1u	/* the compaction planner fenced it off */
+
+typedef struct ArenaSeg {
+  void *base;		/* start of the payload */
+  void *freelist;	/* intrusive LIFO of this segment's free slots */
+  unsigned char *bits;	/* occupancy bitmap (KIMIX_LUA_MEMCHECK only) */
+  unsigned nslots;
+  unsigned nfree;
+  unsigned flags;
+} ArenaSeg;
+
+typedef struct ArenaClass {
+  unsigned slot_size;		/* bytes handed out per slot */
+  unsigned nslots_per_seg;	/* slots carved out of one segment */
+  unsigned seg_payload;		/* nslots_per_seg * slot_size */
+  int tier;			/* ARENA_TIER_* */
+  unsigned seg_count;
+  unsigned slots_total;		/* seg_count * nslots_per_seg */
+  unsigned slots_used;
+  unsigned slots_free;
+  unsigned high_water;		/* peak 'slots_used', decays on trim */
+  ArenaSeg **segs;		/* sorted by 'base', ascending */
+  unsigned seg_cap;
+  ArenaSeg *cur;		/* allocation hint */
+} ArenaClass;
+
+/* one cached huge run: exact size only, so it is reusable verbatim */
+typedef struct ArenaHuge {
+  void *p;
+  size_t size;
+} ArenaHuge;
+
+typedef struct lua_Arena {
+  lua_ArenaConfig cfg;
+  ArenaClass classes[ARENA_MAX_CLASSES];
+  int nclasses;
